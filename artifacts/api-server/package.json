{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "vapid:generate": "tsx src/generate-vapid-keys.ts",
    "seed": "tsx src/seed.ts",
    "seed:demo": "tsx src/seed-demo.ts",
    "seed:demo:reset": "tsx src/seed-demo-reset.ts",
    "historical:dry-run": "tsx src/historical-migration-dry-run.ts",
    "historical:prepare": "tsx src/historical-migration-prepare.ts",
    "historical:stage": "tsx src/historical-migration-stage.ts",
    "historical:promote": "tsx src/historical-migration-promote.ts",
    "historical:review": "tsx src/historical-migration-review-action.ts",
    "historical:customer-resolution-plan": "tsx src/historical-customer-resolution-plan.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.47",
    "@clerk/shared": "^4.25.8",
    "@google-cloud/storage": "^7.21.0",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.0",
    "http-proxy-middleware": "^4.2.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.4",
    "pdfkit": "^0.19.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "web-push": "^3.6.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pdfkit": "^0.17.6",
    "@types/web-push": "^3.6.4",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
