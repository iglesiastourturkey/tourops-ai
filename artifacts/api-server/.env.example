# --- Object storage (GCS) ---
# Standard GCP service-account key JSON, as a single-line string.
# Replaces the old Replit sidecar-based credentials — required on Render.
GCS_SERVICE_ACCOUNT_KEY=

# Optional default bucket, used only when PRIVATE_OBJECT_DIR /
# PUBLIC_OBJECT_SEARCH_PATHS don't already embed a bucket name as their
# first path segment.
GCS_BUCKET_NAME=

# GCS path (starting with the bucket name) used for private object storage,
# e.g. /my-bucket/private
PRIVATE_OBJECT_DIR=

# Comma-separated GCS paths to search for public objects,
# e.g. /my-bucket/public
PUBLIC_OBJECT_SEARCH_PATHS=
