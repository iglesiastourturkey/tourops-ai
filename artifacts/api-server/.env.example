# --- Object storage (GCS) ---
# Standard GCP service-account key JSON, as a single-line string.
# Replaces the old Replit sidecar-based credentials — required on Render.
GCS_SERVICE_ACCOUNT_KEY=

# Optional default bucket, used only when PRIVATE_OBJECT_DIR /
# PUBLIC_OBJECT_SEARCH_PATHS don't already embed a bucket name as their
# first path segment.
GCS_BUCKET_NAME=

# GCS path (starting with the bucket name) used for private object storage,
# e.g. /my-bucket/private
PRIVATE_OBJECT_DIR=

# Comma-separated GCS paths to search for public objects,
# e.g. /my-bucket/public
PUBLIC_OBJECT_SEARCH_PATHS=

# --- n8n communication status integration (read-only) ---
# Keep disabled until migration 0010 is applied and the signed staging smoke
# test succeeds. This integration accepts status summaries only.
COMMUNICATIONS_INTEGRATION_ENABLED=false

# Server-enforced tenant slug. The n8n payload tenantId must match exactly.
COMMUNICATIONS_TENANT_ID=iglesias-tour

# HMAC-SHA256 secret, minimum 32 random characters. Never commit a real value.
COMMUNICATIONS_WEBHOOK_SECRET=
