# Backend API origin. Required in production (Vercel) since the frontend and
# the API server (Render) now live on different origins — without this, API
# calls fall back to a same-origin relative path (/api/...) and 404.
# Leave unset for local dev, where a single dev server / proxy serves both.
# Example: https://tourops-ai.onrender.com
VITE_API_URL=

# Clerk publishable key for the client-side SDK.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: Clerk proxy URL, only needed if Clerk is configured behind a proxy.
VITE_CLERK_PROXY_URL=
