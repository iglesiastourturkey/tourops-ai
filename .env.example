# ─────────────────────────────────────────────────────────────────────────────
# TourOps AI — Environment Variables
#
# Copy this file to .env and fill in the values for local development.
# On Replit, all variables are managed via the Secrets pane — do not commit
# a populated .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# On Replit this is auto-injected by the built-in database.
# Locally: provision a Postgres instance (e.g. via Docker, Neon, or Supabase)
# and paste the connection string here.
DATABASE_URL=postgresql://user:password@localhost:5432/tourops

# ── Clerk Authentication ──────────────────────────────────────────────────────
# Obtain these from your Clerk dashboard (https://dashboard.clerk.com).
# On Replit they are provided by the Replit-managed Clerk integration.

# Backend secret key — never expose this to the browser.
CLERK_SECRET_KEY=sk_test_...

# Publishable key used by the API server for key resolution.
CLERK_PUBLISHABLE_KEY=pk_test_...

# Publishable key exposed to the Vite frontend (must start with VITE_).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Session ───────────────────────────────────────────────────────────────────
# Any long random string. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# ── AI (optional) ────────────────────────────────────────────────────────────
# When absent, all AI endpoints return safe mock responses automatically.
# When present, live GPT-4o-mini calls are made via the OpenAI API.
# OPENAI_API_KEY=sk-...

# ── Microsoft Outlook OAuth (optional) ───────────────────────────────────────
# Azure AD / Microsoft Entra ID app registration for the Outlook mail
# connection (Mail.Read, delegated). Absent = the Outlook settings panel shows
# "not configured" and the connect button is disabled; nothing else breaks.
# MICROSOFT_OAUTH_CLIENT_ID=...
# MICROSOFT_OAUTH_CLIENT_SECRET=...
# Redirect URI registered on the app registration. Must end in
# /api/reservations/outlook-connection/callback
# MICROSOFT_OAUTH_REDIRECT_URI=https://api.example.com/api/reservations/outlook-connection/callback
# The app registration's Directory (tenant) ID. Required because the app is
# single-tenant — the multi-tenant "common" authority will not accept it.
# MICROSOFT_OAUTH_TENANT_ID=...
# MICROSOFT_OAUTH_SUCCESS_URL=/settings?outlook=connected

# ── Public contact form email delivery (optional) ───────────────────────────
# Backend-only SMTP settings. Do not put these values in VITE_* variables.
# CONTACT_SMTP_HOST=smtp.example.com
# CONTACT_SMTP_PORT=587
# CONTACT_SMTP_SECURE=false
# CONTACT_SMTP_USER=your-smtp-username
# CONTACT_SMTP_PASSWORD=your-smtp-password
# CONTACT_SMTP_FROM_EMAIL=TourPilot <noreply@example.com>

# ── Server ports (optional) ───────────────────────────────────────────────────
# Defaults: frontend → 5173, API server → 8080.
# On Replit these are injected automatically.
# PORT=5173

# ── Frontend base path (optional) ────────────────────────────────────────────
# The URL prefix the frontend is served from. Defaults to "/".
# On Replit this is injected automatically (e.g. "/tourops-ai").
# BASE_PATH=/
